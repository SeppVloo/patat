@inject IJSRuntime JS
<div class="pt-card">
    <h2>📦 Voorraad beheren</h2>
    <p class="pt-muted">Snacks met dezelfde frituurgroep mogen samen gebakken worden. Laat de groep leeg om een snack altijd los te bakken.</p>
    <Scanner Engine="Engine" Changed="Changed" />
    <div class="pt-stock">
        <div class="pt-stock-row head">
            <span></span><span>Snack</span><span>Voorraad</span><span>Per pak</span><span>Min.</span><span>Frituurgroep</span><span></span>
        </div>
        @foreach (var s in Rows())
        {
            <div class="pt-stock-row @(s.Stock <= 0 ? "empty" : s.Stock <= 2 ? "low" : "")" @key="s.Id" @onfocusin="() => Focus(s)">
                <button class="pt-iconbtn" title="Icoon kiezen" @onclick="() => TogglePick(s)"><SnackIcon Snack="s" Size="34" /></button>
                <input class="pt-input name" @bind="s.Name" @bind:after="Changed" maxlength="30" />
                <span class="pt-stepper">
                    <button class="pt-round" @onclick="() => Add(s, -1)" disabled="@(s.Stock <= 0)">−</button>
                    <input class="pt-input num" type="number" min="0" @bind="s.Stock" @bind:after="Changed" />
                    <button class="pt-round" @onclick="() => Add(s, 1)">+</button>
                    <button class="pt-btn small pt-pack" title="Heel pak toevoegen" @onclick="() => Add(s, Math.Max(1, s.PackSize))">+ pak (@Math.Max(1, s.PackSize))</button>
                </span>
                <label class="pt-f"><small>Per pak</small><input class="pt-input num" type="number" min="1" max="200" title="Stuks per pak" @bind="s.PackSize" @bind:after="Changed" /></label>
                <label class="pt-f"><small>Min.</small><input class="pt-input num" type="number" min="1" max="30" @bind="s.FryMinutes" @bind:after="Changed" /></label>
                <label class="pt-f group"><small>Frituurgroep</small><input class="pt-input" @bind="s.FryGroup" @bind:after="Changed" placeholder="los" maxlength="20" /></label>
                <button class="pt-round danger del" title="Verwijderen" @onclick="() => Remove(s)">🗑</button>
            </div>
            @if (_pick == s.Id)
            {
                <div class="pt-picker">
                    <button class="pt-pick @(s.Icon == "" ? "active" : "")" title="Automatisch op naam" @onclick="() => SetIcon(s, string.Empty)"><SnackIcon IconKey="@AutoKey(s)" Size="30" /><small>Auto</small></button>
                    @foreach (var i in SnackIcons.All)
                    {
                        <button class="pt-pick @(s.Icon == i.Key ? "active" : "")" title="@i.Title" @onclick="() => SetIcon(s, i.Key)"><SnackIcon IconKey="@i.Key" Size="30" /><small>@i.Title</small></button>
                    }
                    <span class="pt-pick @(s.Icon == SnackIcons.EmojiKey ? "active" : "")">
                        <input class="pt-input emoji" @bind="s.Emoji" @bind:after="() => SetIcon(s, SnackIcons.EmojiKey)" maxlength="4" title="Eigen emoji" />
                        <small>Emoji</small>
                    </span>
                </div>
            }
        }
    </div>
    @if (Engine.Groups() is { Count: > 1 } groups)
    {
        <h3 class="pt-sub">Volgorde frituurgroepen</h3>
        <ol class="pt-groups">
            @for (var i = 0; i < groups.Count; i++)
            {
                var g = groups[i];
                var first = i == 0;
                var last = i == groups.Count - 1;
                <li>
                    <span>@g</span>
                    <button class="pt-round" title="Omhoog" disabled="@first" @onclick="() => MoveGroup(g, -1)">▲</button>
                    <button class="pt-round" title="Omlaag" disabled="@last" @onclick="() => MoveGroup(g, 1)">▼</button>
                </li>
            }
        </ol>
    }
    <div class="pt-row">
        <button class="pt-btn" @onclick="AddSnack">➕ Snack toevoegen</button>
        <button class="pt-btn ghost" @onclick="Resort" title="Opnieuw sorteren op groep en naam">↕ Sorteren</button>
        <button class="pt-btn ghost" @onclick="Defaults">Standaardlijst terugzetten</button>
    </div>
    @if (Engine.State.Orders.Count > 0)
    {
        <p class="pt-muted">Let op: de voorraad hierboven is al verminderd met de @Engine.State.Orders.Count lopende bestelling(en).</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public PatatEngine Engine { get; set; } = default!;
    [Parameter] public Func<Task> Changed { get; set; } = () => Task.CompletedTask;

    private string? _pick;

    private Task MoveGroup(string g, int delta) { Engine.MoveGroup(g, delta); Resort(); return Changed(); }

    // The order is fixed while editing, so rows don't jump around; it is refreshed when the page opens,
    // the group order changes or via the sort button. New snacks are added at the bottom.
    private List<string> _order = [];

    protected override void OnInitialized() => Resort();

    private void Resort() => _order = Engine.Sorted(x => x.Stock > 0).Select(x => x.Id).ToList();

    private IEnumerable<Snack> Rows()
    {
        foreach (var s in Engine.State.Snacks) if (!_order.Contains(s.Id)) _order.Add(s.Id);
        return Engine.State.Snacks.OrderBy(s => _order.IndexOf(s.Id));
    }
    private bool _moved;

    // An open icon picker follows the row that has the focus.
    private void Focus(Snack s)
    {
        _moved = _pick is not null && _pick != s.Id;
        if (_moved) _pick = s.Id;
    }

    private void TogglePick(Snack s)
    {
        // Focus just moved the picker here; keep it open instead of closing it again.
        if (_moved && _pick == s.Id) { _moved = false; return; }
        _moved = false;
        _pick = _pick == s.Id ? null : s.Id;
    }

    private static string AutoKey(Snack s) => SnackIcons.Guess(s.Name) is { Length: > 0 } k ? k : "snack";

    private Task SetIcon(Snack s, string key)
    {
        s.Icon = key;
        // Take over the icon's name as long as the user hasn't typed a name himself.
        if (SnackIcons.Find(key) is { } i && i.Key != "snack" && IsDefaultName(s.Name)) s.Name = i.Title;
        return Changed();
    }

    private static bool IsDefaultName(string? name) =>
        string.IsNullOrWhiteSpace(name) || name.Trim() == NewName || SnackIcons.All.Any(i => i.Title == name.Trim());

    private const string NewName = "Nieuwe snack";

    private Task Add(Snack s, int delta)
    {
        s.Stock = Math.Max(0, s.Stock + delta);
        return Changed();
    }

    private Task AddSnack()
    {
        Engine.State.Snacks.Add(new Snack { Name = NewName });
        _pick = Engine.State.Snacks[^1].Id;
        return Changed();
    }

    private async Task Remove(Snack s)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"{s.Name} verwijderen? (Ongedaan maken kan daarna nog.)")) return;
        Engine.State.Snacks.Remove(s);
        await Changed();
    }

    private async Task Defaults()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Standaardlijst terugzetten? Al je eigen snacks, voorraad en bestellingen worden vervangen. (Ongedaan maken kan daarna nog.)")) return;
        Engine.State.Snacks = PatatEngine.DefaultSnacks();
        Engine.State.Orders.Clear();
        Engine.State.Batches.Clear();
        await Changed();
    }
}

@implements IDisposable
@inject IJSRuntime JS

<div class="pt-card">
    <div class="pt-row spread">
        <h2>👨‍🍳 Bakken</h2>
        <label class="pt-check"><input type="checkbox" @bind="Engine.State.Open" @bind:after="Changed" /> Bestellen open</label>
    </div>

    @if (Engine.State.Orders.Count == 0)
    {
        <p class="pt-muted">Nog geen bestellingen. Iedereen kan nu op zijn eigen apparaat bestellen.</p>
    }
    else
    {
        var plan = Engine.Plan();
        <p class="pt-muted">@plan.Count mandje(s), samen ongeveer @plan.Sum(b => b.Minutes) minuten met één frituurpan. Langste eerst, zodat de rest nog warm is.</p>
        <div class="pt-batches">
            @foreach (var b in plan)
            {
                var st = Engine.BatchState(b.Key);
                var left = Left(st, b.Minutes);
                <div class="pt-batch @BatchClass(st, left)">
                    <div class="pt-batch-head">
                        <b>@b.Title</b><span>@b.Minutes min</span>
                    </div>
                    <ul>
                        @foreach (var (s, n) in b.Items)
                        {
                            <li><b>@n×</b> <SnackIcon Snack="s" Size="22" /> @s.Name</li>
                        }
                    </ul>
                    @if (st.Done)
                    {
                        <span class="pt-ok">✅ Klaar</span>
                        <button class="pt-btn ghost small" @onclick="() => Reset(st)">Opnieuw</button>
                    }
                    else if (left.HasValue)
                    {
                        <span class="pt-timer">@TimerText(left.Value)</span>
                        <button class="pt-btn small" @onclick="() => Done(st)">✅ Klaar</button>
                    }
                    else
                    {
                        <button class="pt-btn small" @onclick="() => Start(st)">▶ Start</button>
                        <button class="pt-btn ghost small" @onclick="() => Done(st)">✅ Klaar</button>
                    }
                </div>
            }
        </div>
    }
</div>

@if (Engine.State.Orders.Count > 0)
{
    <div class="pt-card">
        <h2>🧾 Per persoon</h2>
        <ul class="pt-orders">
            @foreach (var o in Engine.State.Orders.OrderBy(o => o.Time))
            {
                <li>
                    <b>@o.Person</b>
                    <span class="pt-items">
                        @foreach (var (id, n) in o.Items)
                        {
                            var s = Engine.Find(id);
                            <span class="pt-item">@(n)× <SnackIcon Snack="s" Size="20" /> @s?.Name</span>
                        }
                    </span>
                    @if (!string.IsNullOrEmpty(o.Note))
                    {
                        <i>“@o.Note”</i>
                    }
                    <button class="pt-round danger" title="Bestelling verwijderen" @onclick="() => Cancel(o.Person)">✕</button>
                </li>
            }
        </ul>
        <h3>Totaal</h3>
        <div class="pt-totals">
            @foreach (var (id, n) in Engine.Totals())
            {
                var s = Engine.Find(id);
                <span class="pt-total">@(n)× <SnackIcon Snack="s" Size="20" /> @s?.Name</span>
            }
        </div>
        <button class="pt-btn big" @onclick="Finish">🍽 Nieuwe ronde (bestellingen wissen)</button>
    </div>
}

@if (Engine.State.History.Count > 0)
{
    <details class="pt-card">
        <summary><b>📜 Geschiedenis</b> <span class="pt-muted">(@Engine.State.History.Count rondes, laatste jaar)</span></summary>
        @foreach (var r in Engine.State.History.OrderByDescending(r => r.Time))
        {
            <h3>@r.Time.ToLocalTime().ToString("ddd d MMM yyyy HH:mm", Nl)</h3>
            <ul class="pt-orders">
                @foreach (var o in r.Orders)
                {
                    <li>
                        <b>@o.Person</b>
                        <span class="pt-items">
                            @foreach (var (id, n) in o.Items)
                            {
                                <span class="pt-item">@(n)× @(r.Names.GetValueOrDefault(id) ?? Engine.Find(id)?.Name ?? id)</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }
    </details>
}

@code {
    [Parameter, EditorRequired] public PatatEngine Engine { get; set; } = default!;
    [Parameter] public Func<Task> Changed { get; set; } = () => Task.CompletedTask;

    private static readonly System.Globalization.CultureInfo Nl = new("nl-NL");
    private Timer? _timer;

    protected override void OnInitialized() =>
        _timer = new Timer(_ => InvokeAsync(Tick), null, 1000, 1000);

    // Batches that already rang, plus the last time, so the alarm repeats every 15s until Klaar.
    private readonly Dictionary<string, DateTime> _rang = [];

    private async Task Tick()
    {
        StateHasChanged();
        if (Engine.State.Orders.Count == 0) return;
        var now = DateTime.UtcNow;
        var ring = false;
        foreach (var b in Engine.Plan())
        {
            var st = Engine.State.Batches.FirstOrDefault(x => x.Key == b.Key);
            if (st is null || st.Done || Left(st, b.Minutes) is not { } l || l > TimeSpan.Zero) continue;
            if (_rang.TryGetValue(b.Key, out var last) && now - last < TimeSpan.FromSeconds(15)) continue;
            _rang[b.Key] = now;
            ring = true;
        }
        if (ring) await Beep(4);
    }

    private async Task Beep(int n)
    {
        try { await JS.InvokeVoidAsync("patatBeep", n); } catch (JSException) { }
    }

    private static TimeSpan? Left(Batch b, int minutes) =>
        b.StartedUtc.HasValue ? TimeSpan.FromMinutes(minutes) - (DateTime.UtcNow - b.StartedUtc.Value) : null;

    private static string BatchClass(Batch b, TimeSpan? left) =>
        b.Done ? "done" : left is null ? "" : left.Value <= TimeSpan.Zero ? "ready" : "busy";

    private static string TimerText(TimeSpan rest) =>
        rest <= TimeSpan.Zero ? "⏰ Eruit halen!" : $"⏱ {rest:m\\:ss}";

    private async Task Start(Batch b) { await Beep(0); _rang.Remove(b.Key); b.StartedUtc = DateTime.UtcNow; await Changed(); }
    private Task Done(Batch b) { b.Done = true; return Changed(); }
    private Task Reset(Batch b) { _rang.Remove(b.Key); b.Done = false; b.StartedUtc = null; return Changed(); }
    private Task Cancel(string person) { Engine.Cancel(person); return Changed(); }
    private Task Finish() { Engine.Finish(); return Changed(); }

    public void Dispose() => _timer?.Dispose();
}

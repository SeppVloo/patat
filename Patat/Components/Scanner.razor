@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="pt-scan">
    <div class="pt-row">
        @if (!_on)
        {
            <button class="pt-btn" @onclick="Start">📷 Streepjescode scannen</button>
        }
        <input class="pt-input" inputmode="numeric" placeholder="of typ de code" @bind="_typed" @onkeydown="TypedKey" />
        <button class="pt-btn ghost small" @onclick="UseTyped" disabled="@string.IsNullOrWhiteSpace(_typed)">OK</button>
        <button class="pt-btn ghost small" @onclick="() => _showList = !_showList">🏷 Codes (@Engine.State.Snacks.Sum(s => s.Barcodes.Count))</button>
    </div>
    @if (_on)
    {
        <div class="pt-scan-box">
            <video @ref="_video" muted playsinline></video>
            <button class="pt-btn ghost small" @onclick="Stop">Stoppen</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_msg))
    {
        <p class="pt-msg @(_error ? "error" : "")">@_msg</p>
    }
    @if (_unknown is not null)
    {
        <div class="pt-scan-new">
            <b>Onbekende code @_unknown</b>
            <label>Hoort bij
                <select class="pt-input" @bind="_target">
                    <option value="">➕ Nieuwe snack</option>
                    @foreach (var s in Engine.State.Snacks.OrderBy(x => x.Name))
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </label>
            @if (_target == "")
            {
                <label>Naam <input class="pt-input" @bind="_newName" maxlength="30" /></label>
            }
            <label>Merk/omschrijving <input class="pt-input" @bind="_label" maxlength="40" /></label>
            <label>Stuks per pak (deze code) <input class="pt-input num" type="number" min="1" max="200" @bind="_pack" /></label>
            <div class="pt-row">
                <button class="pt-btn" @onclick="Link" disabled="@(_target == "" && string.IsNullOrWhiteSpace(_newName))">Opslaan en pak toevoegen</button>
                <button class="pt-btn ghost" @onclick="() => _unknown = null">Overslaan</button>
            </div>
        </div>
    }
    @if (_showList)
    {
        <div class="pt-codes">
            <div class="pt-codes-head">
                <b>🏷 Gekoppelde codes</b>
                <input class="pt-input" placeholder="🔍 Zoek snack, merk of code" @bind="_filter" @bind:event="oninput" />
            </div>
            @if (!Engine.State.Snacks.Any(s => s.Barcodes.Count > 0))
            {
                <p class="pt-muted">Nog geen streepjescodes gekoppeld. Scan een pak om te beginnen.</p>
            }
            @foreach (var s in CodeSnacks())
            {
                <div class="pt-codes-snack">
                    <div class="pt-codes-title">
                        <SnackIcon Snack="s" Size="28" />
                        <b>@s.Name</b>
                        <span class="pt-badge">@s.Barcodes.Count @(s.Barcodes.Count == 1 ? "code" : "codes")</span>
                    </div>
                    @foreach (var b in s.Barcodes.Where(b => Matches(s, b)).ToList())
                    {
                        <div class="pt-code-row">
                            <div class="pt-code-main">
                                <input class="pt-input pt-code-label" placeholder="Merk / omschrijving" value="@b.Label" @onchange="e => SetLabel(b, e.Value)" maxlength="40" />
                                <code>@b.Code</code>
                            </div>
                            <label class="pt-code-pack" title="Stuks per pak">
                                <input class="pt-input num" type="number" min="1" max="200" value="@b.PackSize" @onchange="e => SetPack(b, e.Value)" />
                                <span>st.</span>
                            </label>
                            <button class="pt-round danger" title="Code loskoppelen" @onclick="() => Unlink(s, b)">🗑</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PatatEngine Engine { get; set; } = default!;
    [Parameter] public Func<Task> Changed { get; set; } = () => Task.CompletedTask;

    private IJSObjectReference? _js;
    private DotNetObjectReference<Scanner>? _self;
    private ElementReference _video;
    private bool _on, _error, _showList;
    private string? _msg, _unknown;
    private string _target = "", _newName = "", _label = "", _typed = "";
    private int _pack = 1;

    private async Task<IJSObjectReference> Js() =>
        _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./patat-scan.js?v=3");

    private async Task Start()
    {
        _msg = null;
        _on = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            _self ??= DotNetObjectReference.Create(this);
            await (await Js()).InvokeVoidAsync("start", _video, _self);
        }
        catch (JSException ex)
        {
            _on = false;
            Show("Camera starten lukt niet: " + ex.Message, true);
        }
    }

    private async Task Stop()
    {
        _on = false;
        if (_js is not null) try { await _js.InvokeVoidAsync("stop"); } catch (JSException) { }
    }

    private void Show(string msg, bool error = false) => (_msg, _error) = (msg, error);

    private async Task TypedKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UseTyped();
    }

    private async Task UseTyped()
    {
        var code = new string(_typed.Where(char.IsLetterOrDigit).ToArray());
        _typed = "";
        if (code != "") await OnScan(code);
    }

    [JSInvokable]
    public async Task OnScan(string code)
    {
        // Close the camera as soon as a code is recognised, so you can continue.
        await Stop();
        code = code.Trim();
        if (Engine.ByBarcode(code) is { } hit)
        {
            var (s, b) = hit;
            var pack = Math.Max(1, b.PackSize);
            s.Stock += pack;
            Show($"✅ +{pack} {s.Name}{(b.Label == "" ? "" : $" ({b.Label})")} (nu {s.Stock})");
            await Changed();
        }
        else if (_unknown != code)
        {
            _unknown = code;
            _target = "";
            _pack = 1;
            _label = "";
            _newName = "";
            Show($"Nieuwe code {code}: kies de snack of maak een nieuwe aan.");
            StateHasChanged();
            try
            {
                var json = await (await Js()).InvokeAsync<string>("lookup", code);
                using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrEmpty(json) ? "{}" : json);
                string Get(string n) => doc.RootElement.TryGetProperty(n, out var v) ? v.GetString() ?? "" : "";
                _label = Get("label");
                var text = Get("text");
                var all = _label + " | " + text;
                var match = Engine.MatchSnack(all);
                if (match is not null)
                {
                    _target = match.Id;
                    _pack = Math.Max(1, match.PackSize);
                }
                if (PatatEngine.GuessPack(all) is > 0 and var n) _pack = n;
                Show(_label == ""
                    ? $"Nieuwe code {code}: onbekend product, kies de snack."
                    : match is null ? $"Nieuwe code: {_label}. Kies de snack." : $"Nieuwe code: {_label}. Herkend als {match.Name}, klopt dat?");
            }
            catch (Exception ex) when (ex is JSException or System.Text.Json.JsonException) { }
            _newName = _label;
        }
        StateHasChanged();
    }

    private async Task Link()
    {
        if (_unknown is null) return;
        var s = Engine.Find(_target);
        if (s is null)
        {
            s = new Snack { Name = _newName.Trim(), PackSize = Math.Max(1, _pack) };
            Engine.State.Snacks.Add(s);
        }
        var b = new Barcode { Code = _unknown, PackSize = Math.Max(1, _pack), Label = _label.Trim() };
        s.Barcodes.Add(b);
        s.Stock += b.PackSize;
        Show($"✅ Code gekoppeld aan {s.Name}: +{b.PackSize} (nu {s.Stock})");
        _unknown = null;
        await Changed();
    }

    private string _filter = "";

    private IEnumerable<Snack> CodeSnacks() =>
        Engine.State.Snacks.Where(s => s.Barcodes.Any(b => Matches(s, b))).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase);

    private bool Matches(Snack s, Barcode b)
    {
        var f = _filter.Trim();
        return f == "" || s.Name.Contains(f, StringComparison.CurrentCultureIgnoreCase)
            || b.Label.Contains(f, StringComparison.CurrentCultureIgnoreCase) || b.Code.Contains(f);
    }

    private async Task SetLabel(Barcode b, object? value)
    {
        b.Label = (value?.ToString() ?? "").Trim();
        await Changed();
    }

    private async Task SetPack(Barcode b, object? value)
    {
        if (int.TryParse(value?.ToString(), out var n)) b.PackSize = Math.Clamp(n, 1, 200);
        await Changed();
    }

    private async Task Unlink(Snack s, Barcode b)
    {
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("confirm", $"Code {b.Code} loskoppelen van {s.Name}?"); } catch (JSException) { return; }
        if (!ok) return;
        s.Barcodes.Remove(b);
        await Changed();
    }

    public async ValueTask DisposeAsync()
    {
        await Stop();
        if (_js is not null) try { await _js.DisposeAsync(); } catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}

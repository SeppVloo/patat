@page "/"
@page "/{Tab}"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Patat bestellen</PageTitle>

<div class="pt">
    <div class="pt-head">
        <h1 class="pt-logo">🍟 PATAT</h1>
        <span class="pt-status @(Connected ? "on" : "")">@StatusText</span>
    </div>
    @if (_online.Count > 0)
    {
        <div class="pt-online" title="Wie heeft de app nu open">🟢 Online: @string.Join(", ", _online.Select(p => p.Baker ? p.Name + " 👨‍🍳" : p.Name))</div>
    }

    @if (!_ready)
    {
        <p class="pt-muted">Laden…</p>
    }
    else if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_code) || _editSetup)
    {
        <div class="pt-card">
            <h2>Wie ben jij?</h2>
            <label>Je naam <input class="pt-input" @bind="_nameInput" placeholder="bijv. Sepp" maxlength="20" /></label>
            <label>Gezinscode <input class="pt-input" @bind="_codeInput" placeholder="zelfde code voor iedereen" maxlength="30" /></label>
			<label class="pt-check"><input type="checkbox" @bind="_bakkerInput" /> Ik ben de snackbakker (beheert de voorraad en bestellingen van deze gezinscode)</label>
			@if (!string.IsNullOrEmpty(_lanCode) && !string.Equals(_lanCode, _codeInput.Trim(), StringComparison.OrdinalIgnoreCase))
			{
				<button class="pt-btn ghost" @onclick="() => _codeInput = _lanCode!">ðŸ“¶ Gezin op dit wifi-netwerk gevonden: gebruik code <b>@_lanCode</b></button>
			}
            @if (!string.IsNullOrEmpty(_lanInfo))
            {
                <p class="pt-muted">@_lanInfo @if (!_bakkerInput) { <button class="pt-btn ghost small" @onclick="FindLan">🔄 Zoek opnieuw</button> }</p>
            }
			@if (_bakker && _bakkerInput)
			{
				<label class="pt-check"><input type="checkbox" checked="@_engine.State.WifiJoin" @onchange="e => SetWifiJoin((bool)e.Value!)" /> Apparaten op mijn wifi-netwerk herkennen als gezin (stelt de gezinscode voor)</label>
			}
            @if (_bakker && _bakkerInput && !string.IsNullOrWhiteSpace(_code) && !string.IsNullOrWhiteSpace(_codeInput) && !string.Equals(_codeInput.Trim(), _code, StringComparison.OrdinalIgnoreCase))
            {
                <label class="pt-check"><input type="checkbox" @bind="_moveStock" /> Voorraad, codes en geschiedenis meenemen naar de nieuwe gezinscode (vervangt wat daar staat)</label>
                <p class="pt-muted">Iedereen in het gezin moet daarna ook de nieuwe gezinscode invullen.</p>
            }
            <button class="pt-btn big" @onclick="SaveSetup" disabled="@(string.IsNullOrWhiteSpace(_nameInput) || string.IsNullOrWhiteSpace(_codeInput))">Klaar</button>
        </div>
        <Help />
    }
    else
    {
        <div class="pt-tabs">
            <a class="pt-tab @(CurrentTab == "" ? "active" : "")" href="./">🛒 Bestellen</a>
            @if (_bakker)
            {
                <a class="pt-tab @(CurrentTab == "bakker" ? "active" : "")" href="bakker">👨‍🍳 Bakken</a>
                <a class="pt-tab @(CurrentTab == "voorraad" ? "active" : "")" href="voorraad">📦 Voorraad</a>
            }
            <button class="pt-tab small" @onclick="OpenSetup">⚙ @_name@(_bakker ? " (bakker)" : "")</button>
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="pt-msg @(_msgError ? "error" : "")" @onclick="() => _msg = null">@_msg</div>
        }

        @if (_bakker && _undo.Count > 0 && CurrentTab is "bakker" or "voorraad")
        {
            <div class="pt-undo"><button class="pt-btn ghost small" @onclick="Undo" title="Laatste wijziging ongedaan maken">↶ Ongedaan maken (@_undo.Count)</button></div>
        }

        @if (CurrentTab == "bakker" && _bakker)
        {
            <BakkerView Engine="_engine" Changed="Edit" />
        }
        else if (CurrentTab == "voorraad" && _bakker)
        {
            <VoorraadView Engine="_engine" Changed="Edit" />
        }
        else if (!_bakker && !_hasState)
        {
            <div class="pt-card">
                <h2>⏳ Wachten op de snackbakker…</h2>
                <p class="pt-muted">Vraag de snackbakker om de patat-app te openen met gezinscode <b>@_code</b>.</p>
            </div>
        }
        else
        {
            <div class="pt-card">
                <h2>Wat wil je, @_name?</h2>
                @if (!_engine.State.Open)
                {
                    <p class="pt-msg error">🔒 De bestellingen zijn gesloten.</p>
                }
                <div class="pt-snacks">
                    @foreach (var s in _engine.Sorted(x => _engine.MaxFor(x.Id, _name) > 0))
                    {
                        var max = _engine.MaxFor(s.Id, _name);
                        var n = _draft.GetValueOrDefault(s.Id);
                        <div class="pt-snack @(max == 0 ? "empty" : "")">
                            <span class="pt-emoji">
                                <SnackIcon Snack="s" Size="40" />
                                <SnackInfo Snack="s" />
                            </span>
                            <span class="pt-name">@s.Name<small>@(max == 0 ? "op" : $"nog {max - n} over")</small></span>
                            <button class="pt-round" @onclick="() => Change(s.Id, -1)" disabled="@(n == 0)">−</button>
                            <b class="pt-count">@n</b>
                            <button class="pt-round" @onclick="() => Change(s.Id, 1)" disabled="@(n >= max || !_engine.State.Open)">+</button>
                        </div>
                    }
                </div>
                <label>Opmerking (saus, extra zout…) <input class="pt-input" @bind="_note" maxlength="80" /></label>
                <div class="pt-row">
                    <button class="pt-btn big" @onclick="() => SendOrder()" disabled="@(!_engine.State.Open || _draft.Values.Sum() == 0)">✅ Bestelling doorgeven</button>
                    @if (_engine.OrderOf(_name) is not null)
                    {
                        <button class="pt-btn ghost" @onclick="CancelOrder">Annuleren</button>
                    }
                </div>
                @if (_pending is not null || _pendingCancel)
                {
                    <p class="pt-muted">📡 Versturen naar de snackbakker…</p>
                }
                else if (_engine.OrderOf(_name) is { } mine)
                {
                    <p class="pt-ok">👍 De snackbakker heeft je bestelling: @Describe(mine)</p>
                }
            </div>
            <Help />
        }
    }
</div>

@code {
    [Parameter] public string? Tab { get; set; }

    private const string KeyName = "patat.name", KeyCode = "patat.code", KeyBakker = "patat.bakker",
        KeyState = "patat.state", KeyPending = "patat.pending";

    private readonly PatatEngine _engine = new();
    private IJSObjectReference? _js, _db;
    private bool _dbOn, _dbSeen;
    private DotNetObjectReference<PatatPage>? _self;
    private bool _ready, _bakker, _hasState, _editSetup, _bakkerInput, _msgError, _pendingCancel, _draftTouched;
    private string _name = "", _code = "", _nameInput = "", _codeInput = "", _note = "";
    private string? _msg;
    private int _peers;
	private bool _moveStock = true, _forceUpload;
    private string? _lanCode, _lanInfo;

	private async Task SetWifiJoin(bool on)
	{
		Remember();
		_engine.State.WifiJoin = on;
		await Publish();
		await Announce();
	}

	/// <summary>Baker: (un)publish the family code for devices on the same wifi network.</summary>
	private async Task Announce()
	{
		if (_db is null || !_bakker || string.IsNullOrWhiteSpace(_code)) return;
        var err = await JsGet<string?>(_db, "lanAnnounce", _code, _engine.State.WifiJoin);
        _lanInfo = string.IsNullOrEmpty(err)
            ? (_engine.State.WifiJoin ? "📶 Gezinscode is zichtbaar voor apparaten op dit wifi-netwerk." : null)
            : "📶 Wifi-herkenning werkt niet: " + err;
	}

	/// <summary>Non-baker: look for a family announced on this wifi network.</summary>
	private async Task FindLan()
	{
		if (_db is null || _bakker) return;
        _lanInfo = "📶 Zoeken naar je gezin op dit wifi-netwerk…";
        StateHasChanged();
        _lanCode = null;
        var json = await JsGet<string?>(_db, "lanFind");
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrEmpty(json) ? "{}" : json);
            var r = doc.RootElement;
            var code = r.TryGetProperty("code", out var c) ? c.GetString() : null;
            var error = r.TryGetProperty("error", out var e) ? e.GetString() : "geen antwoord";
            _lanCode = string.IsNullOrWhiteSpace(code) ? null : code;
            _lanInfo = _lanCode is null ? "📶 Geen gezin gevonden: " + error : null;
        }
        catch (System.Text.Json.JsonException) { _lanInfo = null; }
        if (_lanCode is not null && string.IsNullOrWhiteSpace(_codeInput)) _codeInput = _lanCode;
		StateHasChanged();
	}
    private List<OnlineUser> _online = [];
    private sealed record OnlineUser(string Name, bool Baker);
    private Order? _pending;
    private Dictionary<string, int> _draft = [];

    private string CurrentTab => (Tab ?? "").ToLowerInvariant();
    private string StateKey => KeyState + "." + _code.Trim().ToLowerInvariant();
    private bool Connected => _bakker || _hasState;
    private string StatusText => (_dbOn ? "☁ " : "") + (_bakker ? $"👨‍🍳 Bakker · {_peers} verbonden" : _hasState ? "🟢 Verbonden" : string.IsNullOrWhiteSpace(_code) ? "⚪ Nog geen gezinscode" : "🔴 Niet verbonden");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _js = await JsGet<IJSObjectReference>(JS, "import", "./patat.js");
        _db = await JsGet<IJSObjectReference>(JS, "import", "./patat-db.js");
        _name = await JsGet<string?>(_js, "load", KeyName) ?? "";
        _code = await JsGet<string?>(_js, "load", KeyCode) ?? "";
        _bakker = await JsGet<string?>(_js, "load", KeyBakker) == "1";
        (_nameInput, _codeInput, _bakkerInput) = (_name, _code, _bakker);
        if (_bakker) await LoadState();
        var pending = await JsGet<string?>(_js, "load", KeyPending);
        if (!string.IsNullOrEmpty(pending))
        {
            try { _pending = System.Text.Json.JsonSerializer.Deserialize<Order>(pending, PatatEngine.Json); } catch (System.Text.Json.JsonException) { }
        }
        LoadDraft();
        _self = DotNetObjectReference.Create(this);
		await Connect();
		if (string.IsNullOrWhiteSpace(_code)) _ = FindLan();
        _ready = true;
        StateHasChanged();
    }

    private async Task Connect()
    {
        _online = [];
        if (_js is null || string.IsNullOrWhiteSpace(_code)) return;
        _hasState = false;
        await JsVoid(_js, "start", _self, _code, _bakker, StateKey);
        _dbSeen = false;
		_dbOn = await JsGet<bool>(_db, "start", _self, _code, _bakker, _name);
		if (_dbOn) await Announce();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDbPresence(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            _online = doc.RootElement.EnumerateArray()
                .Select(e => new OnlineUser(
                    e.TryGetProperty("name", out var n) ? n.GetString() ?? "?" : "?",
                    e.TryGetProperty("baker", out var b) && b.ValueKind == System.Text.Json.JsonValueKind.True))
                .GroupBy(u => u.Name, StringComparer.OrdinalIgnoreCase)
                .Select(g => new OnlineUser(g.First().Name, g.Any(u => u.Baker)))
                .OrderByDescending(u => u.Baker).ThenBy(u => u.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        catch (System.Text.Json.JsonException) { _online = []; }
        StateHasChanged();
    }

	private async Task OpenSetup()
	{
		_editSetup = true;
		await FindLan();
	}

	private async Task SaveSetup()
    {
        if (_js is null) return;
        var reconnect = _codeInput.Trim() != _code || _bakkerInput != _bakker || _nameInput.Trim() != _name;
        var move = _moveStock && _bakker && _bakkerInput && !string.Equals(_codeInput.Trim(), _code, StringComparison.OrdinalIgnoreCase)
            ? _engine.ToJson() : null;
        _moveStock = false;
        var oldCode = _code;
        if (move is not null) await JsVoid(_db, "closeFamily", oldCode);
        (_name, _code, _bakker) = (_nameInput.Trim(), _codeInput.Trim(), _bakkerInput);
        if (move is not null)
        {
            await JsVoid(_js, "save", StateKey, move);
            _forceUpload = true;
        }
        await JsVoid(_js, "save", KeyName, _name);
        await JsVoid(_js, "save", KeyCode, _code);
        await JsVoid(_js, "save", KeyBakker, _bakker ? "1" : null);
        _editSetup = false;
        if (_bakker) await LoadState();
        if (reconnect) await Connect();
        _draftTouched = false;
        LoadDraft();
        // A device without a copy of this family's stock must not spread the default list: wait for the cloud/peers.
        if (_bakker && _hasLocalState) await Publish();
    }

    private bool _hasLocalState;

    private int _draftRound = -1;

    private void LoadDraft()
    {
        // New round started by the baker: everybody starts again from zero.
        if (_draftRound != _engine.State.Round) { _draftRound = _engine.State.Round; _draftTouched = false; }
        if (_pending is not null && _pending.Round != _engine.State.Round) { _pending = null; _ = SavePending(); }
        if (_draftTouched) return;
        var mine = _pending ?? _engine.OrderOf(_name);
        _draft = mine is null ? [] : new(mine.Items);
        _note = mine?.Note ?? "";
    }

    private void Change(string id, int delta)
    {
        _draftTouched = true;
        var n = Math.Clamp(_draft.GetValueOrDefault(id) + delta, 0, _engine.MaxFor(id, _name));
        if (n == 0) _draft.Remove(id); else _draft[id] = n;
        _ = AutoSend();
    }

    private CancellationTokenSource? _autoSend;

    /// <summary>Pass each +/- on to the baker shortly after clicking, so everybody sees the stock go down right away.</summary>
    private async Task AutoSend()
    {
        _autoSend?.Cancel();
        var cts = _autoSend = new CancellationTokenSource();
        try { await Task.Delay(700, cts.Token); } catch (TaskCanceledException) { return; }
        if (!_engine.State.Open) return;
        if (_draft.Values.Sum() > 0) await SendOrder(silent: true);
        else if (_engine.OrderOf(_name) is not null || _pending is not null) await Withdraw();
        StateHasChanged();
    }

    private void Show(string? msg, bool error = false) => (_msg, _msgError) = (msg, error);

    private async Task SendOrder(bool silent = false)
    {
        _autoSend?.Cancel();
        var order = new Order { Person = _name, Items = new(_draft), Note = _note.Trim(), Stamp = Guid.NewGuid().ToString("N"), Round = _engine.State.Round };
        _draftTouched = false;
        if (_bakker)
        {
            var err = _engine.PlaceOrder(order);
            if (!silent || err is not null) Show(err ?? "👍 Bestelling staat erin!", err is not null);
            await Publish();
            return;
        }
        _pending = order;
        _pendingCancel = false;
        Show(null);
        await SavePending();
        await SendPending();
    }

    private async Task CancelOrder()
    {
        if (!await JsGet<bool>(JS, "confirm", "Je bestelling annuleren?")) return;
        _draft.Clear();
        _note = "";
        await Withdraw();
    }

    private async Task Withdraw()
    {
        _autoSend?.Cancel();
        _draftTouched = false;
        if (_bakker)
        {
            _engine.Cancel(_name);
            await Publish();
            return;
        }
        _pending = null;
        _pendingCancel = true;
        await SavePending();
        await SendPending();
    }

    private async Task SavePending()
    {
        if (_js is null) return;
        await JsVoid(_js, "save", KeyPending, _pending is null ? null : System.Text.Json.JsonSerializer.Serialize(_pending, PatatEngine.Json));
    }

    private async Task SendPending()
    {
        if (_js is null) return;
        if (_pending is not null) await JsVoid(_js, "order", System.Text.Json.JsonSerializer.Serialize(_pending, PatatEngine.Json));
        else if (_pendingCancel) await JsVoid(_js, "cancel", _name);
        if (!_dbOn) return;
        if (_pending is not null) await JsVoid(_db, "order", System.Text.Json.JsonSerializer.Serialize(_pending, PatatEngine.Json));
        else if (_pendingCancel) await JsVoid(_db, "cancel", _name);
    }

    private async Task LoadState()
    {
        if (_js is null) return;
        _engine.Reset();
        // State is stored per family code; fall back to the old device-wide key (before per-code storage).
        var json = await JsGet<string?>(_js, "load", StateKey);
        if (string.IsNullOrWhiteSpace(json)) json = await JsGet<string?>(_js, "load", KeyState);
        _hasLocalState = !string.IsNullOrWhiteSpace(json);
        if (!_engine.Load(json))
        {
            // Keep the unreadable state safe instead of overwriting it with the default list.
            await JsVoid(_js, "save", StateKey + ".backup-" + DateTime.UtcNow.ToString("yyyyMMddHHmmss"), json);
            Show("⚠ Opgeslagen voorraad kon niet gelezen worden; er is een reservekopie bewaard.", true);
        }
        _lastJson = _engine.ToJson();
    }

    // Undo: snapshots of the state before each change by the baker (kept in memory, newest last).
    private readonly List<string> _undo = [];
    private string? _lastJson;

    private void Remember()
    {
        if (_lastJson is null || _lastJson == _engine.ToJson()) return;
        _undo.Add(_lastJson);
        if (_undo.Count > 50) _undo.RemoveAt(0);
    }

    /// <summary>A change made by the baker in this app (undoable), as opposed to incoming orders.</summary>
    private Task Edit() { Remember(); return Publish(); }

    private async Task Undo()
    {
        if (_undo.Count == 0) return;
        var version = _engine.State.Version;
        var json = _undo[^1];
        _undo.RemoveAt(_undo.Count - 1);
        if (!_engine.Load(json)) return;
        _engine.State.Version = version;
        _lastJson = null;
        await Publish();
        _lastJson = _engine.ToJson();
        Show("↶ Laatste wijziging ongedaan gemaakt.");
    }

    private async Task Publish()
    {
        if (_js is null || !_bakker) return;
        _engine.State.Version++;
        var json = _engine.ToJson();
        _lastJson = json;
        await JsVoid(_js, "save", StateKey, json);
        await JsVoid(_js, "broadcast", json, null);
        // Until the cloud state has been read, never overwrite it: the cloud is leading.
        if (_dbOn && _dbSeen) await JsVoid(_db, "save", json);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDbState(string json)
    {
        if (!_bakker)
        {
            if (!string.IsNullOrWhiteSpace(json)) await OnState(json);
            return;
        }
        var first = !_dbSeen;
        _dbSeen = true;
        if (first && _forceUpload)
        {
            // Stock was moved to this new family code: it replaces whatever is stored there.
            _forceUpload = false;
            await Publish();
            return;
        }
        // The cloud is leading: take over every state there that this device did not write itself,
        // regardless of version numbers (another device may have counted higher while offline).
        if (!string.IsNullOrWhiteSpace(json) && json != _lastJson && _engine.Load(json))
        {
            _lastJson = json;
            // The database has a newer version (e.g. changed on another baker device).
            await JsVoid(_js, "save", StateKey, json);
            await JsVoid(_js, "broadcast", json, null);
            LoadDraft();
            StateHasChanged();
        }
        else if (first)
        {
            // Database empty or older than this device: upload our state (also migrates existing local stock).
            await Publish();
        }
    }

    /// <summary>The baker changed the family code: this code is closed. Ask for the new one (it is not revealed).</summary>
    [JSInvokable]
    public async Task OnDbClosed()
    {
        await JsVoid(_js, "leave");
        _code = _codeInput = "";
        _hasState = _dbOn = false;
        _online = [];
        await JsVoid(_js, "save", KeyCode, null);
        _editSetup = true;
        Show("De snackbakker heeft de gezinscode veranderd. Vraag de nieuwe code en vul die hieronder in.", true);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDbInbox(string key, string json)
    {
        if (!_bakker) return;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var type = root.TryGetProperty("type", out var t) ? t.GetString() : null;
            if (type == "order" && root.TryGetProperty("json", out var o) && o.GetString() is { } orderJson) await OnOrder(orderJson);
            else if (type == "cancel" && root.TryGetProperty("person", out var p) && p.GetString() is { } person) await OnCancel(person);
        }
        catch (System.Text.Json.JsonException) { }
        await JsVoid(_db, "done", key);
    }

    private string Describe(Order o) => string.Join(", ", o.Items.Select(kv => $"{kv.Value}× {_engine.Find(kv.Key)?.Name}"))
        + (string.IsNullOrEmpty(o.Note) ? "" : $" ({o.Note})");

    // JS interop can fail (private browsing, blocked storage, page closing); that must not crash the page.
    private static async Task JsVoid(IJSObjectReference? module, string identifier, params object?[] args)
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync(identifier, args); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { Console.WriteLine($"JS '{identifier}' mislukt: {ex.Message}"); }
    }

    private static async Task<T?> JsGet<T>(IJSObjectReference? module, string identifier, params object?[] args)
    {
        if (module is null) return default;
        try { return await module.InvokeAsync<T>(identifier, args); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { Console.WriteLine($"JS '{identifier}' mislukt: {ex.Message}"); return default; }
    }

    private static async Task<T?> JsGet<T>(IJSRuntime js, string identifier, params object?[] args)
    {
        try { return await js.InvokeAsync<T>(identifier, args); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { Console.WriteLine($"JS '{identifier}' mislukt: {ex.Message}"); return default; }
    }

    [JSInvokable]
    public async Task OnState(string json)
    {
        if (_bakker) return;
        if (!_engine.Load(json)) return;
        // Every device keeps the latest state of its family, so any device can take over as baker.
        await JsVoid(_js, "save", StateKey, json);
        _hasState = true;
        if (_pending is not null && _pending.Round != _engine.State.Round)
        {
            _pending = null;
            await SavePending();
        }
        if (_pending is not null)
        {
            if (_engine.State.Rejected.TryGetValue(_pending.Stamp, out var why))
            {
                Show("❌ " + why, true);
                _pending = null;
            }
            else if (_engine.OrderOf(_name)?.Stamp == _pending.Stamp)
            {
                Show("👍 Bestelling ontvangen door de snackbakker!");
                _pending = null;
            }
            else await SendPending();
            await SavePending();
        }
        else if (_pendingCancel)
        {
            if (_engine.OrderOf(_name) is null) _pendingCancel = false; else await SendPending();
        }
        LoadDraft();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnOrder(string json)
    {
        Order? order;
        try { order = System.Text.Json.JsonSerializer.Deserialize<Order>(json, PatatEngine.Json); } catch (System.Text.Json.JsonException) { return; }
        if (order is null) return;
        if (_engine.OrderOf(order.Person)?.Stamp == order.Stamp || _engine.State.Rejected.ContainsKey(order.Stamp))
        {
            await Publish();
            return;
        }
        var err = _engine.PlaceOrder(order);
        if (err is not null) _engine.State.Rejected[order.Stamp] = err;
        else Show($"🔔 Nieuwe bestelling van {order.Person}");
        await Publish();
    }

    [JSInvokable]
    public async Task OnCancel(string person)
    {
        _engine.Cancel(person);
        await Publish();
    }

    [JSInvokable]
    public async Task OnHello(string peer, string? json)
    {
        if (_js is null || !_bakker) return;
        if (!_dbOn && _engine.TryAdopt(json))
        {
            // Another device had a newer version (e.g. the baker used a different device before).
            _engine.State.Version--;
            await Publish();
            return;
        }
        await JsVoid(_js, "broadcast", _engine.ToJson(), peer);
    }

    [JSInvokable]
    public void OnPeers(int n)
    {
        _peers = n;
        if (n == 0 && !_bakker && !_dbOn) _hasState = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_js is not null)
        {
            await JsVoid(_js, "leave");
            try { await _js.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        if (_db is not null)
        {
            await JsVoid(_db, "stop");
            try { await _db.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
